# ============================================================================
# NomosX — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================================

# --- REQUIRED ---

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/nomosx?pgbouncer=true&connection_limit=5"

# Security / Auth (min 32 characters)
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Admin key (min 16 characters in production)
ADMIN_KEY="change-me-admin-key-16-chars"

# --- OPTIONAL (have defaults or graceful fallbacks) ---

# Academic APIs (defaults provided in lib/env.ts)
# OPENALEX_API="https://api.openalex.org/works"
# CROSSREF_API="https://api.crossref.org/works"
# SEMANTICSCHOLAR_API="https://api.semanticscholar.org/graph/v1/paper/search"
# THESESFR_API="https://www.theses.fr/api/v1/theses"
UNPAYWALL_EMAIL="your-email@example.com"

# Identity enrichment
# ROR_API="https://api.ror.org/organizations"
# ORCID_API="https://pub.orcid.org/v3.0"

# Macro data
# EUROSTAT_API="https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data"
# ECB_API="https://data-api.ecb.europa.eu/service/data"
# INSEE_API="https://api.insee.fr/series/BDM/V1/data"
# INSEE_API_KEY=""

# Anthropic (Claude fallback)
# ANTHROPIC_API_KEY=""

# Cohere (reranking)
# COHERE_API_KEY=""

# CORE API (additional research sources)
# CORE_API_KEY="..."

# Redis (caching & rate limiting — strongly recommended for production)
# REDIS_URL="redis://localhost:6379"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Sentry (error tracking)
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# NEXT_PUBLIC_SENTRY_DSN=""

# Email (Resend) — required for welcome emails + newsletter confirmation
RESEND_API_KEY="re_..."
EMAIL_FROM="NomosX <noreply@nomosx.com>"
RESEND_WEBHOOK_SECRET=""   # Optional — set to verify Resend webhook signatures

# Cron security
# CRON_SECRET="change-me-cron-secret"

# Editorial V2 — position-first briefs (casting → arbiter → institute position)
EDITORIAL_V2=true

# Editorial cadence
# Maximum autonomous publications per rolling 7-day window
# NOMOSX_WEEKLY_PUBLICATION_MAX="3"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production example:
# NODE_ENV="production"
# NEXT_PUBLIC_APP_URL="https://nomosx.com"
# JWT_SECRET="generate-a-64-character-random-secret"
# ADMIN_KEY="generate-a-32-character-random-admin-key"
# CRON_SECRET="generate-a-32-character-random-cron-secret"
# REDIS_URL="redis://default:password@host:6379"

# Real-time economic data (optional — enables FRED indicators in analyses)
# Get a FREE key at https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY="your_fred_api_key_here"

# News Intelligence (live event monitoring — optional)
# GDELT is free (no key needed). NewsAPI adds Reuters, AP, BBC headlines.
# Get a free key at https://newsapi.org/register
# NEWSAPI_KEY="your_newsapi_key_here"

# MediaStack (7500+ global news sources — free tier: 500 req/month)
# Get a free key at https://mediastack.com/signup/free
# MEDIASTACK_KEY="your_mediastack_key_here"

# TheNewsAPI (business & tech news — free tier: 3 req/day)
# Get a free key at https://www.thenewsapi.com/register
# THENEWSAPI_KEY="your_thenewsapi_key_here"

# GNews (Google News alternative — free tier: 100 req/day)
# Get a free key at https://gnews.io/register
# GNEWS_KEY="your_gnews_key_here"

# EventRegistry (news analytics & event detection — free tier: 2000 tokens/month)
# Get a free key at https://eventregistry.org/register
# EVENTREGISTRY_KEY="your_eventregistry_key_here"

# LinkUp (complementary web search — grey literature, think tanks, real-time web)
# Get an API key at https://www.linkup.so
# LINKUP_API_KEY="your_linkup_api_key_here"

# Stripe (StudioX pay-per-commission)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Légifrance PISTE API (French legal database — optional, enables legifrance provider)
# Register at https://piste.gouv.fr to get OAuth2 credentials
# LEGIFRANCE_API_KEY="your_piste_client_id"
# LEGIFRANCE_API_SECRET="your_piste_client_secret"

# Node environment
NODE_ENV="development"
