{
  "name": "nomosx-full-agentic-v1",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate && git config core.hooksPath .githooks 2>/dev/null || true",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.mjs",
    "test:all": "jest && jest --config jest.integration.config.mjs",
    "test:openai": "node scripts/test-openai.mjs",
    "test:system": "node scripts/test-system.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "prisma:gen": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed-demo-data.mjs",
    "worker": "npm run worker:pipeline",
    "worker:pipeline": "tsx --env-file=.env.local scripts/pipeline-worker.ts",
    "worker:temporal": "tsx --env-file=.env.local scripts/temporal-worker.ts",
    "worker:pipeline:once": "tsx --env-file=.env.local scripts/pipeline-worker.ts --once",
    "seed": "node scripts/seed.mjs",
    "seed:domains": "node scripts/seed-domains.mjs",
    "classify": "node scripts/classify-sources.mjs",
    "test:institutional": "node scripts/test-institutional-v2.mjs",
    "test:rss": "node scripts/test-rss-feeds.mjs",
    "smoke:editorial-v2": "tsx scripts/smoke-editorial-v2.ts",
    "smoke:editorial-v2:full": "tsx scripts/smoke-editorial-v2.ts --full",
    "monitoring:dashboard": "node scripts/monitoring-dashboard.mjs",
    "build:esm": "NODE_OPTIONS=\"--loader ts-node/esm\" next build",
    "dev:esm": "NODE_OPTIONS=\"--loader ts-node/esm\" next dev",
    "netlify:dev": "netlify dev",
    "netlify:build": "npm run build",
    "netlify:deploy": "netlify deploy --prod",
    "lint": "eslint . --cache",
    "lint:strict": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "health": "node scripts/health-check.mjs",
    "health:json": "node scripts/health-check.mjs --json",
    "quality:audit": "tsx scripts/audit-publication-quality.ts",
    "quality:hold": "tsx scripts/audit-publication-quality.ts --hold",
    "eval:golden": "tsx --env-file=.env.local scripts/eval-golden.ts",
    "eval:golden:update": "tsx --env-file=.env.local scripts/eval-golden.ts --update",
    "eval:runs": "tsx --env-file=.env.local scripts/eval-runs.ts",
    "eval:runs:update": "tsx --env-file=.env.local scripts/eval-runs.ts --update",
    "eval:gepa": "tsx --env-file=.env.local scripts/eval-gepa.ts",
    "eval:gepa:llm": "tsx --env-file=.env.local scripts/eval-gepa.ts --llm",
    "foresight:backfill": "tsx scripts/backfill-foresight-metadata.ts",
    "foresight:backfill:dry": "tsx scripts/backfill-foresight-metadata.ts --dry-run",
    "audit:institutional": "tsx scripts/institutional-quality-audit.ts",
    "audit:institutional:strict": "tsx scripts/institutional-quality-audit.ts --strict --published-only",
    "audit:institutional:full": "tsx scripts/institutional-quality-audit.ts --pipeline --live-test --html audit-report.html",
    "agents:improve": "tsx scripts/improve-agents-from-publication-audit.ts",
    "agents:improve:apply": "tsx scripts/improve-agents-from-publication-audit.ts --apply",
    "preflight:live": "node scripts/preflight-live.mjs --prod",
    "preflight:live:json": "node scripts/preflight-live.mjs --prod --json",
    "verify:live": "npm run preflight:live && npm run lint && npm run test && npm run build",
    "pre-commit": "npm run lint && npm run test && npm run build",
    "ci": "npm run lint && npm run test:coverage && npm run build",
    "eval": "tsx eval/run.ts",
    "eval:steps": "tsx --env-file=.env.local scripts/analyze-step-value.ts",
    "replay": "tsx --env-file=.env.local scripts/replay-run.ts",
    "replay:inspect": "tsx scripts/replay-run.ts --inspect"
  },
  "prisma": {
    "seed": "node scripts/seed-demo-data.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@crazygl/hero-neon-fluid": "^0.1.1",
