    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sentry/nextjs": "^10.36.0",
    "@sparticuz/chromium": "^119.0.0",
    "@tailwindcss/typography": "^0.5.13",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "ai": "^6.0.48",
    "axios": "^1.13.2",
    "baseline-browser-mapping": "^2.9.19",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.2.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cockatiel": "^4.0.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "import-in-the-middle": "^3.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.2.0",
    "linkup-sdk": "^2.6.2",
    "lucide-react": "^0.376.0",
    "next": "^16.1.3",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.12",
    "openai": "^4.0.0",
    "p-limit": "^7.3.1",
    "pdf-parse": "^2.4.5",
    "puppeteer-core": "^24.36.0",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.6.0",
    "require-in-the-middle": "^8.0.1",
    "resend": "^6.9.1",
    "rss-parser": "^3.13.0",
    "stripe": "^16.12.0",
    "tailwind-merge": "^2.2.0",
    "three": "^0.183.2",
    "tslib": "^2.8.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^18.3.12",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.4.16",
    "cypress": "^15.9.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "knip": "^5.88.1",
    "netlify-cli": "^17.0.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "undici": "^7.29.1"
  },
  "optionalDependencies": {
    "@netlify/esbuild-linux-64": "0.14.39"
  }
}
