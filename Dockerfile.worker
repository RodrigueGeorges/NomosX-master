# NomosX durable pipeline worker — standalone image.
#
# The Next.js Dockerfile builds the web app; THIS image runs
# scripts/pipeline-worker.ts: the DB-backed job runner that executes
# think-tank cycles and StudioX orders without HTTP timeout constraints.
#
# Build:  docker build -f Dockerfile.worker -t nomosx-worker .
# Run:    docker run --env-file .env.production -p 3001:3001 nomosx-worker
#
# tsx lives in devDependencies and prisma generate runs via postinstall,
# so this image installs the full dependency tree (build stays lean —
# no Next.js compile step is needed for the worker).

FROM node:20-alpine

RUN apk add --no-cache libc6-compat
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

# Prisma schema must land BEFORE install: postinstall runs `prisma generate`
# against it, and npm ci fails without the schema file.
# .npmrc carries legacy-peer-deps=true — required or npm ci fails on the
# react 18 / @react-three peer conflict.
COPY .npmrc package.json yarn.lock* package-lock.json* pnpm-lock.yaml* ./
COPY prisma ./prisma
RUN if [ -f yarn.lock ]; then yarn; \
    elif [ -f package-lock.json ]; then npm ci; \
    elif [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm i; \
    else echo "Lockfile not found." && exit 1; fi

# Source: the worker only needs scripts/ + lib/ + shared config.
COPY tsconfig.json ./
COPY scripts ./scripts
COPY lib ./lib
COPY next.config.* ./

EXPOSE 3001
ENV PORT=3001

CMD ["npx", "tsx", "scripts/pipeline-worker.ts", "--health-port=3001"]
