# Langfuse self-hosted secrets — copy to .env and replace every CHANGE-ME.
# Generate:  ENCRYPTION_KEY: openssl rand -hex 32
#            SALT / NEXTAUTH_SECRET / REDIS_AUTH / POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD: random strings

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:CHANGE-ME@postgres:5432/postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE-ME

REDIS_AUTH=CHANGE-ME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE-ME

SALT=CHANGE-ME
ENCRYPTION_KEY=CHANGE-ME-64-hex-chars
NEXTAUTH_SECRET=CHANGE-ME
NEXTAUTH_URL=http://localhost:3000

# Optional: pre-provision org/project/user on first boot
# LANGFUSE_INIT_ORG_NAME=NomosX
# LANGFUSE_INIT_PROJECT_NAME=nomosx-pipeline
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-...
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-...
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=CHANGE-ME
